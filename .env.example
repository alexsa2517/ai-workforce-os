# AI Workforce OS - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Security (REQUIRED in production)
# ============================================
API_KEY=your-strong-api-key-min-16-chars
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# ============================================
# Application
# ============================================
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT=100/minute

# ============================================
# LLM Providers (at least one required)
# ============================================
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

GOOGLE_API_KEY=...
GEMINI_MODEL=gemini-1.5-pro

DEEPSEEK_API_KEY=...
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Fallback order: comma-separated list
LLM_FALLBACK_ORDER=openai,deepseek,gemini

# ============================================
# Database (PostgreSQL recommended)
# ============================================
DATABASE_URL=postgresql+asyncpg://aiworkforce:password@localhost:5432/ai_workforce
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Voice & Media
# ============================================
TTS_PROVIDER=openai
TTS_VOICE=alloy
TTS_MODEL=tts-1
TTS_SPEED=1.0
TTS_LANGUAGE=th
MOVIES_DIR=./movies

# ============================================
# Monitoring
# ============================================
METRICS_ENABLED=true
