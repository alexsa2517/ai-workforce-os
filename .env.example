# AI Workforce OS - Environment Configuration
# Copy this file to .env and fill in real API keys. Never commit .env.

# Core LLMs
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-pro
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# AI Money Lab - Kimi / Moonshot
KIMI_API_KEY=your_kimi_api_key_here
KIMI_MODEL=kimi-k2.5
KIMI_BASE_URL=https://api.moonshot.ai/v1

# AI Money Lab - Claude / Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=https://api.anthropic.com

# AI Money Lab - Manus API v2
MANUS_API_KEY=your_manus_api_key_here
MANUS_BASE_URL=https://api.manus.ai

# Application
APP_NAME=AI Workforce OS
APP_VERSION=0.3.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Security
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Database
DATABASE_URL=sqlite:///./ai_workforce.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Voice / media
TTS_PROVIDER=openai
TTS_VOICE=alloy
TTS_MODEL=tts-1
TTS_SPEED=1.0
TTS_LANGUAGE=th
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=aura-asteria-en

# Lip sync
LIP_SYNC_PROVIDER=did
LIP_SYNC_RESOLUTION=720p
D_ID_API_KEY=your_d_id_api_key_here
D_ID_BASE_URL=https://api.d-id.com
HEDRA_API_KEY=your_hedra_api_key_here
HEDRA_BASE_URL=https://api.hedra.com

# Movie pipeline
MOVIES_DIR=./movies
SCENES_PER_EPISODE=5
MAX_PARALLEL_JOBS=3
CHARACTER_FILE=linhfeng.json
WORLD_FILE=ancient-world.json
BACKGROUND_MUSIC_PATH=
SUBTITLE_FONT=NotoSansThai-Regular.ttf

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ai_workforce.log

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# Director AI
DIRECTOR_AI_ENABLED=true
KNOWLEDGE_BASE_PATH=./knowledge/director-ai
