# AI Workforce OS - Environment Variables
# ============================================
# อัตโนมัติโดย AI Workforce OS Improved
# ============================================

# ============================================
# Security (REQUIRED)
# ============================================
API_KEY=ai-workforce-secure-key-2026
JWT_SECRET=ai-workforce-jwt-secret-key-min-32-chars

# ============================================
# LLM Providers
# ============================================
OPENAI_API_KEY=sk-e72d1baa748d4d3db5573d049fc8e6fd
OPENAI_MODEL=gpt-4o

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Fallback order
LLM_FALLBACK_ORDER=openai,deepseek,gemini

# ============================================
# Application
# ============================================
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT=100/minute

# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL=postgresql+asyncpg://aiworkforce:password@localhost:5432/ai_workforce
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Voice & Media
# ============================================
TTS_PROVIDER=openai
TTS_VOICE=alloy
TTS_MODEL=tts-1
TTS_SPEED=1.0
TTS_LANGUAGE=th
MOVIES_DIR=./movies

# ============================================
# Monitoring
# ============================================
METRICS_ENABLED=true
