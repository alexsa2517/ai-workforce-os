# ============================================
# AI Workforce OS - Environment Configuration
# ============================================
# คัดลอกไฟล์นี้เป็น .env แล้วเติม API Key ของคุณ
# cp .env.sample .env
# ============================================

# ============================================
# 1. OpenAI API (สำหรับ TTS สร้างเสียงตัวละครพูด)
# ============================================
# สมัคร: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"

# ============================================
# 2. Google Gemini API (สำหรับสร้างภาพตัวละคร/ฉาก)
# ============================================
# สมัคร: https://aistudio.google.com/apikey
GEMINI_API_KEY="AIza-your-gemini-api-key-here"

# ============================================
# 3. Hedra API (สำหรับ Lip-Sync ทำให้ตัวละครพูดได้จริง)
# ============================================
# สมัคร: https://www.hedra.com
HEDRA_API_KEY="hx-your-hedra-api-key-here"

# ============================================
# 4. D-ID API (ทางเลือกสำรองสำหรับ Lip-Sync)
# ============================================
# สมัคร: https://studio.d-id.com
D_ID_API_KEY="your-did-api-key-here"

# ============================================
# 5. ElevenLabs API (ทางเลือกสำรองสำหรับ TTS เสียงคุณภาพสูง)
# ============================================
# สมัคร: https://elevenlabs.io
ELEVENLABS_API_KEY="sk-your-elevenlabs-api-key-here"

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ============================================
# Director AI Settings
# ============================================
DIRECTOR_AI_MODEL=gemini-2.0-flash
DIRECTOR_AI_TEMPERATURE=0.7

# ============================================
# Image Generation Settings
# ============================================
IMAGE_PROVIDER=gemini
IMAGE_WIDTH=1280
IMAGE_HEIGHT=720

# ============================================
# TTS Settings
# ============================================
TTS_PROVIDER=openai
TTS_VOICE=alloy
TTS_SPEED=1.0

# ============================================
# Lip-Sync Settings
# ============================================
LIP_SYNC_PROVIDER=hedra
LIP_SYNC_RESOLUTION=720p

# ============================================
# Movie Pipeline Settings
# ============================================
MOVIES_DIR=./movies
SCENES_PER_EPISODE=5
MAX_PARALLEL_JOBS=3
