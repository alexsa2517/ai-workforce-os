# AI Workforce OS — Environment Template
# Copy to .env and fill real secrets locally. Never commit real keys.

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Gemini / Nano Banana / Veo
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview

# Real media is disabled until the quality gates and credentials are verified.
REAL_MEDIA_ENABLED=false

# Application security
APP_API_KEY=
JWT_SECRET=

# Database
DATABASE_URL=sqlite:///./ai_workforce.db

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Production
MOVIES_DIR=./movies
SCENES_PER_EPISODE=5
MAX_PARALLEL_JOBS=3
SUBTITLE_FONT=NotoSansThai-Regular.ttf
