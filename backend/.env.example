# ================================================================
#  AI Workforce OS — ไฟล์ .env (คัดลอกเป็น .env แล้วเติม Key จริง)
# ================================================================
# คำสั่ง:  cp .env.example .env
# จากนั้นเปิด .env แล้วเติม API Key จริงของคุณ
# อ่านคู่มือวิธีขอ Key ฟรีได้ที่: .env.guide
# ================================================================

# ============================================
#  API Keys — เติม Key จริงของคุณที่นี่
# ============================================

# Google Gemini (ฟรี — ขอได้เลยที่ https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# OpenAI TTS (ฟรี $5 สำหรับบัญชีใหม่ — สมัครที่ https://platform.openai.com/signup)
OPENAI_API_KEY="sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ElevenLabs TTS (ฟรี 10,000 credits/เดือน — สมัครที่ https://elevenlabs.io/sign-up)
ELEVENLABS_API_KEY="sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Deepgram TTS (ฟรี $200 — สมัครที่ https://console.deepgram.com/signup)
DEEPGRAM_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Hedra Lip-Sync (ฟรี 3 trials — สมัครที่ https://www.hedra.com/sign-up)
HEDRA_API_KEY="hx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# D-ID Lip-Sync (ฟรี 5 trials — สมัครที่ https://www.d-id.com/sign-up/)
D_ID_API_KEY="xxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# DeepSeek API (ลงทะเบียนที่ https://platform.deepseek.com/)
# หมายเหตุ: deepseek-chat ถูกยกเลิกแล้ว (2026-07-24) ใช้ deepseek-v4-flash แทน
DEEPSEEK_API_KEY="sk-your-deepseek-api-key-here"
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============================================
#  Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ============================================
#  Director AI Settings
# ============================================
DIRECTOR_AI_MODEL=gemini-2.0-flash
DIRECTOR_AI_TEMPERATURE=0.7

# ============================================
#  Image Generation Settings
# ============================================
# ใช้ Gemini (ฟรี) หรือ OpenAI
IMAGE_PROVIDER=gemini
IMAGE_WIDTH=1280
IMAGE_HEIGHT=720

# ============================================
#  TTS Settings
# ============================================
# ผู้ให้บริการ: openai, elevenlabs, deepgram
TTS_PROVIDER=openai

# OpenAI TTS Voice: alloy, echo, fable, onyx, nova, shimmer
TTS_VOICE=alloy

# ElevenLabs Voice: ให้ใส่ Voice ID ที่ได้จาก ElevenLabs dashboard
ELEVENLABS_VOICE_ID=""

# Deepgram Model: aura-asteria-en, aura-luna-en, aura-stella-en
DEEPGRAM_MODEL=aura-asteria-en

TTS_SPEED=1.0
TTS_LANGUAGE=th

# ============================================
#  Lip-Sync Settings
# ============================================
# ผู้ให้บริการ: hedra, did, simulated
# simulated = ไม่ต้องใส่ key (ใช้สำหรับทดสอบ)
LIP_SYNC_PROVIDER=did

# ความละเอียด: 480p, 720p, 1080p
LIP_SYNC_RESOLUTION=720p

# D-ID Settings
D_ID_BASE_URL=https://api.d-id.com

# Hedra Settings
HEDRA_BASE_URL=https://api.hedra.com

# ============================================
#  Movie Pipeline Settings
# ============================================
MOVIES_DIR=./movies
SCENES_PER_EPISODE=5
MAX_PARALLEL_JOBS=3

# ============================================
#  Character Settings
# ============================================
# โหลดตัวละครจากไฟล์ JSON ในโฟลเดอร์ knowledge/
CHARACTER_FILE=linhfeng.json
WORLD_FILE=world.json

# ============================================
#  Video Assembly Settings
# ============================================
# ใส่เพลงพื้นหลัง (file path)
BACKGROUND_MUSIC_PATH=
SUBTITLE_FONT=NotoSansThai-Regular.ttf
